# Victorian Mystery Backgrounds - Ren'Py image definitions
# An All Hours pack. Every scene, every light.
#
# Optional. Copy this file into your game/ folder to use the spaced
# attribute syntax:
#
#     scene vm_bg street rain with dissolve
#
# Without it the images still work, named after their files:
#
#     scene vm_bg_street_rain with dissolve
#
# Ren'Py auto-defines images from game/images/ by filename. Underscores
# are part of the name; only spaces separate attributes. This file just
# declares the spaced aliases for you.

image vm_bg street day = "vm_bg_street_day.png"
image vm_bg street evening = "vm_bg_street_evening.png"
image vm_bg street night = "vm_bg_street_night.png"
image vm_bg street rain = "vm_bg_street_rain.png"
image vm_bg study candlelit = "vm_bg_study_candlelit.png"
image vm_bg study day = "vm_bg_study_day.png"
image vm_bg study evening = "vm_bg_study_evening.png"
image vm_bg study fire = "vm_bg_study_fire.png"
